        </mxCell>
        <mxCell id="32" value="Note: link-layer rate on the XCVR lane after 8b10b is ~4.9 Gb/s, within one PolarFire lane. A decimate-by-2 option keeps a 61.44 MSPS output for lower-rate loopback tests." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#222;fontStyle=2;fontFamily=Helvetica;whiteSpace=nowrap;" vertex="1" parent="1">
